/* nz-mcp - the one stylesheet of the level 2 (full screen) surfaces. ADR 0032, decision 5.
 *
 * House rules
 * -----------
 * 1. No colour value lives in this sheet. Every colour is a $variable, and every variable
 *    is defined by both themes in `nz_mcp/tui/theme.py`, where its contrast is measured.
 *    A screen that needs a colour asks for a role here; it never writes one in its code.
 * 2. Colour underlines, text informs: every state a screen draws also carries a word.
 * 3. One accent (teal). ok / warning / error are the semantic trio and the accent never
 *    competes with them.
 * 4. Three levels of emphasis and never a fourth: bold for the title and the element with
 *    the focus, normal for values, $text-muted for labels, hints and the footer. No italic.
 * 5. Layout stays with the screen that owns it. This sheet moves colour out of the
 *    screens; it does not redraw them (issues #239 and #241 do that).
 *
 * The bands are the one place the sheet neutralises a framework default: Textual tints a
 * focused list or field with 5% of the foreground, which would put a colour on screen that
 * no theme declared and no test measured.
 */

/* ------------------------------------------------------------- every screen --- */

Screen {
    background: $background;
    color: $foreground;
}

#frame {
    padding: 1 2;
}

#title {
    text-style: bold;
    margin-bottom: 1;
}

#keys {
    height: 1;
    color: $text-muted;
}

/* ---------------------------------------------------------------------- menu --- */

/* Tasks on the left, the context panel on the right (ADR 0032, decision 1: "panel
   derecho"). 1fr on the body and on the task column: both grow with the window instead of
   the panel eating space the task list needs. */
#body {
    height: 1fr;
}

#tasks {
    width: 1fr;
}

#context {
    width: 26;
    margin-left: 2;
}

#context-title {
    text-style: bold;
    margin-bottom: 1;
}

#context-status.-ok {
    color: $success;
}

#context-status.-warning {
    color: $warning;
}

#context-status.-error {
    color: $error;
}

/* 1fr and not auto: if this list ever outgrows the window it scrolls, instead of
   pushing the description and the keys off the bottom. */
OptionList {
    height: 1fr;
    background: $background;
    border: none;
    padding: 0;
}

/* The row under the cursor: the band says which, the bold says it has the focus. */
OptionList > .option-list--option-highlighted {
    background: $band-idle;
    color: $accent;
    text-style: none;
}

OptionList:focus {
    background-tint: transparent;
}

OptionList:focus > .option-list--option-highlighted {
    background: $band-focus;
    color: $accent;
    text-style: bold;
}

#describe {
    height: 3;
    margin-top: 1;
    color: $text-muted;
}

/* -------------------------------------------------------------------- wizard --- */

/* The three-step tracker of ADR 0032, decision 4: follows the focus, never advances on
   its own. Bold is what says which step is current; colour is a second carrier, never
   the only one (issue #241). */
#stepper {
    height: 1;
}

.step {
    width: auto;
    color: $text-muted;
}

.step.-current {
    color: $foreground;
    text-style: bold;
}

.step-sep {
    width: auto;
    color: $text-muted;
}

.row {
    height: 1;
}

.label {
    width: 15;
    height: 1;
    color: $text-muted;
}

/* A field sinks into the panel; the one with the focus rises onto the band. */
Input {
    background: $panel;
}

Input:focus {
    background: $band-focus;
    background-tint: transparent;
}

/* No padding: this row has to line up with the values of the fields above it, and a
   compact Input starts its text right at the edge. */
SecretField {
    height: 1;
    background: $panel;
}

SecretField:focus {
    background: $band-focus;
}

/* Doubles as the field-error log of decision 4: the didactic hint of the focused field
   when nothing is broken, one "Label: message" line per broken field when something is
   (issue #241). */
#explain {
    height: 6;
    margin-top: 1;
    color: $text-muted;
}

#explain.-error {
    color: $error;
}

/* ---------------------------------------------------------------- help modal --- */

/* The one place a CLI command is written (ADR 0032, decision 2). A card over the
   screen it was pushed on, not a fourth surface: same sheet, same two themes. */
#help-modal {
    width: 56;
    height: auto;
    border: round $text-muted;
    background: $panel;
    padding: 1 2;
}

/* ------------------------------------------------------------- profiles --- */

/* "Ver perfiles" (ADR 0032, decision 3, issue #240): the header and the row under the
   cursor read from the same bands and the same $text-muted the menu's own list already
   uses, so the two screens do not drift on what a highlighted row looks like. Textual's
   own defaults for these three classes pull from variables this sheet does not declare
   and this project has not measured (`$block-cursor-background`, `$secondary-muted`);
   overriding them is the same move rule 1 of this sheet already made for `OptionList`. */
#profiles {
    height: 1fr;
    background: $background;
}

DataTable > .datatable--header {
    background: $panel;
    color: $text-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $band-idle;
    color: $foreground;
    text-style: none;
}

DataTable:focus {
    background-tint: transparent;
}

DataTable:focus > .datatable--cursor {
    background: $band-focus;
    color: $foreground;
    text-style: bold;
}

#empty {
    height: 3;
    margin-top: 1;
    color: $text-muted;
}

/* ----------------------------------------------------------- actions modal --- */

/* The four actions of one profile (ADR 0032, decision 3). Same card shape as the help
   modal: pushed over the screen it belongs to, not a fourth surface. */
#actions-modal {
    width: 40;
    height: auto;
    border: round $text-muted;
    background: $panel;
    padding: 1 2;
}
